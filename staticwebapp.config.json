{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    { "route": "/api/*", "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": { "statusCode": 401 }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/*.{png,jpg,jpeg,gif,svg,ico,css,js,webp,woff,woff2}"]
  },
  "globalHeaders": {
    "cache-control": "no-store"
  }
}
